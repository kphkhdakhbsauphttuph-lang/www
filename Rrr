task.spawn(function()
    while task.wait(0.2) do
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                char:FindFirstChildOfClass("Humanoid").WalkSpeed = Config.WalkSpeed
                if Config.Noclip then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end

            if Config.AutoGrabEggs and char and char:FindFirstChild("HumanoidRootPart") then
                for _, item in pairs(workspace:GetDescendants()) do
                    if string.find(item.Name:lower(), "egg") then
                        if item:IsA("BasePart") and (item.Position - char.HumanoidRootPart.Position).Magnitude < 30 then
                            firetouchinterest(char.HumanoidRootPart, item, 0)
                            firetouchinterest(char.HumanoidRootPart, item, 1)
                        elseif item:IsA("ProximityPrompt") then
                            fireproximityprompt(item)
                        end
                    end
                end
            end

            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local pChar = plr.Character
                    local highlight = pChar:FindFirstChild("Simple_ESP")
                    if Config.ESP then
                        if not highlight then
                            highlight = Instance.new("Highlight", pChar)
                            highlight.Name = "Simple_ESP"
                        end
                        highlight.FillColor = Color3.fromRGB(0, 243, 255)
                        highlight.OutlineColor = Color3.fromRGB(180, 50, 255)
                    else
                        if highlight then highlight:Destroy() end
                    end

                    local head = pChar:FindFirstChild("Head")
                    if Config.Hitbox and head then
                        head.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                        head.Transparency = 0.5
                        head.CanCollide = false
                    end
                end
            end
        end)
    end
end)
