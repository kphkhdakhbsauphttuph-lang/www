-- ฟังก์ชัน Korblox
local function ApplyKorblox(char)
    if not char then return end
    local rightLowerLeg = char:FindFirstChild("RightLowerLeg")
    local rightUpperLeg = char:FindFirstChild("RightUpperLeg")
    local rightFoot = char:FindFirstChild("RightFoot")
    
    if rightLowerLeg and rightUpperLeg and rightFoot then
        rightLowerLeg.MeshId = "rbxassetid://902942093"
        rightLowerLeg.Transparency = 0
        rightUpperLeg.MeshId = "rbxassetid://902942096"
        rightUpperLeg.TextureID = "rbxassetid://902843398"
        rightFoot.MeshId = "rbxassetid://902942089"
        rightFoot.Transparency = 1
    end
    
    local rightLeg = char:FindFirstChild("Right Leg")
    if rightLeg and not rightLowerLeg then rightLeg.Transparency = 1 end
end

